# CodePolice Description Server — Environment Variables
# Copy this file to .env and fill in your values.

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_SUMMARY_MODEL=qwen2.5:1.5b
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b

# Chunking (time-based)
# 90s rolling window — seals a chunk 90s after the last quiet period
# Set higher (e.g. 300000) if you prefer coarser chunks
CHUNK_WINDOW_MS=90000
CHUNK_MAX_MS=600000

# FAISS
FAISS_SERVICE_URL=http://localhost:3142
# Push directly to FAISS as soon as a chunk seals — set false only to rely on background sync
FAISS_PUSH_ENABLED=true

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3141
NODE_ENV=development

# Alignment thresholds used for snapshot state derivation
ALIGNED_THRESHOLD=0.75
MILD_DRIFT_THRESHOLD=0.5

# Robust LLM alignment scoring uses weighted rubric dimensions:
# objective_match, changed_surface_relevance, implementation_intent, contradiction_penalty
# Final score is confidence-calibrated and stored in change_descriptions.on_task_score

# Optional: forward processed change events to your dashboard backend
# Example: https://your-dashboard-api.example.com/api/codepolice/events
DASHBOARD_WEBHOOK_URL=
