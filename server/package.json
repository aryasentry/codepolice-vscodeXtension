{
    "name": "codepolice-server",
    "version": "1.0.0",
    "description": "CodePolice description server — bridges the VS Code extension to Ollama + Supabase",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
        "watch": "tsc --watch"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.39.0",
        "cors": "^2.8.5",
        "dotenv": "^16.4.1",
        "express": "^4.18.2",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/node": "^20.11.0",
        "@types/uuid": "^9.0.7",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.3.3"
    }
}