# CodePolice FAISS Service — Environment Variables
# Copy to .env and fill in values

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://ihsbsgwdqdcjfbldkcfx.supabase.co
SUPABASE_SERVICE_KEY=PASTE_SERVICE_ROLE_KEY_HERE

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b

# ── FAISS service ─────────────────────────────────────────────────────────────
PORT=3142
FAISS_INDEX_PATH=./faiss_index.bin    # Where to persist the FAISS index on disk
FAISS_META_PATH=./faiss_meta.json     # Parallel metadata store (chunk_id, summary, etc.)
SYNC_INTERVAL_SECONDS=30              # 30s — how often to pull new chunks from Supabase
